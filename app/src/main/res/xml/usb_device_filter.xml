<?xml version="1.0" encoding="utf-8"?>
<!--
    Mass storage (class 8) with Bulk-Only Transport (protocol 0x50) and the MMC (2) or SCSI
    transparent (6) command set: what USB CD/DVD drives present. Android matches these against
    the device and each of its interfaces.
-->
<resources>
    <usb-device class="8" subclass="2" protocol="80" />
    <usb-device class="8" subclass="6" protocol="80" />
</resources>
